# Copy to .env for local development. In real deployments (Render,
# Railway, a VPS, etc.) set these as actual environment variables via the
# host's dashboard instead of shipping this file — it's gitignored.

PORT=8080

# SupaBein project used as the datastore. SUPABEIN_TOKEN must be either
# the project's service_key or the project owner's own PAT — both bypass
# all row policies (a non-owner PAT would be subject to policies as the
# "authenticated" role instead, which this code doesn't grant anything to
# on purpose). Keep this out of git and never send it to a browser.
SUPABEIN_BASE=https://supabein.dxinnovationhub.com/api/v1
SUPABEIN_PROJECT_ID=your-project-id
SUPABEIN_TOKEN=your-service-key-or-owner-pat

# Two separate secrets — one for the laptop agent, one for the phone app —
# so a leaked agent config can't be used to command other devices.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_API_KEY=change-me-device-key
ADMIN_API_KEY=change-me-admin-key

# A device counts "online" if its last heartbeat was within this many
# seconds. Should be a few times the agent's pollIntervalMs.
ONLINE_THRESHOLD_SECONDS=30
