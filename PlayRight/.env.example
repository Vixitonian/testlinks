# Render sets PORT automatically — only needed for local dev.
PORT=3000

# Optional: require this value (as `x-api-key` header or `Authorization: Bearer <key>`)
# on POST /run. Leave unset to disable auth (not recommended in production).
API_KEY=

# Optional: restrict CORS to a specific origin instead of "*".
CORS_ORIGIN=*

# Optional: tuning (all in milliseconds).
DEFAULT_ACTION_TIMEOUT_MS=15000
MAX_ACTION_TIMEOUT_MS=60000
RUN_TIMEOUT_MS=90000

# Optional: concurrency. How many /run requests execute in parallel (each
# gets its own isolated browser context) before extra requests queue.
# Keep this low on small instances (e.g. Render free = 512MB RAM) — each
# concurrent run costs real Chromium memory. Raise it after upgrading plan.
MAX_CONCURRENT_RUNS=3
# How long a queued request waits for a free slot before getting a 503.
QUEUE_TIMEOUT_MS=20000
